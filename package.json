{
  "name": "node-utils-kit",
  "version": "1.2.2",
  "description": "Reusable middleware, validators, and error handlers for Node.js",
  "keywords": [
    "nodejs",
    "api",
    "express",
    "error-handler",
    "error-handling",
    "typescript",
    "async-handler",
    "middleware",
    "api-response",
    "http-error",
    "backend"
  ],
  "license": "MIT",
  "author": "Praveen Kumar",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "prepare": "npm run build"
  },
  "dependencies": {
    "node-utils-kit": "^1.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "semantic-release": "^24.2.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^4.5.0",
    "vitest": "^0.34.6"
  }
}
